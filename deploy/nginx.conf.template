# Rendered by the nginx image at startup: ${VOICE_DOMAIN} and ${BASE_PATH} come from docker-compose.yml
# (defaults: scm.localhost / /voicecall; server: set them in .env). Published on host port 8082; the costing
# project's nginx (host port 80) forwards this name here. default_server: localhost:8082 works too.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Keep the original client details when the request came through the edge nginx
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

map $http_x_real_ip $real_ip {
    default $http_x_real_ip;
    ''      $remote_addr;
}

server {
    listen 80 default_server;
    server_name ${VOICE_DOMAIN};

    client_max_body_size 25m;
    # Relative Location headers, so redirects keep the port the browser used (e.g. :8082)
    absolute_redirect off;

    # The app lives under ${BASE_PATH}/
    location = / {
        return 302 ${BASE_PATH}/;
    }

    location / {
        proxy_pass http://web:8000;
        # /media and /test-ws are websockets
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $real_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        # A call's websocket stays open for the whole call
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
}

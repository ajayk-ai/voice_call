# Copy to .env and fill in. Every setting lives here, so nothing needs a code change.
# Only the first block is required; the rest have working defaults.

# ---- Required ----
# Admin sign-in password (the admin's user id is ADMIN_USERNAME)
APP_PASSWORD=
GEMINI_API_KEY=
TELER_API_KEY=
FREJUN_PHONE_NUMBER=
# Public https address FreJun reaches this server on (a tunnel URL or your domain)
PUBLIC_URL=
ULTRAMSG_BASE_URL=
ULTRAMSG_TOKEN=
GOOGLE_SERVICE_ACCOUNT_FILE=service.json
GOOGLE_DELEGATED_USER=
PO_SHEET_ID=
PO_DB_USER=postgres
PO_DB_PASSWORD=
# Live voice model
GEMINI_MODEL=gemini-3.8-live
# Female voices: Aoede, Kore, Leda, Sulafat, Despina. Male: Achird, Puck, Charon
GEMINI_VOICE=Aoede
# Model that reads call transcripts (delay reason, committed dates)
CALL_ANALYSIS_MODEL=gemini-2.5-flash

# ---- Sign-in ----
ADMIN_USERNAME=admin
# Signs sign-ins. Empty: derived from APP_PASSWORD
SESSION_SECRET=
SESSION_HOURS=12
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# ---- Database ----
PO_DB_HOST=localhost
PO_DB_PORT=5432
PO_DB_NAME=pending_po
# Seconds between Google Sheet syncs (python -m backend.po_sync), and the longest wait after failures
PO_SYNC_INTERVAL_SECONDS=60
PO_SYNC_MAX_BACKOFF_SECONDS=900
SHEETS_TIMEOUT_SECONDS=60

# ---- Follow-up ----
# Repeat interval Vendor Control starts with, and the longest allowed
FOLLOWUP_DEFAULT_INTERVAL_MINUTES=1440
FOLLOWUP_MAX_INTERVAL_DAYS=30
FOLLOWUP_MAX_LINES_PER_MESSAGE=15
FOLLOWUP_SEND_INTERVAL_SECONDS=1.5
# How many times a failed daily run is tried
FOLLOWUP_AUTO_MAX_ATTEMPTS=3
# Scenario 3 voice call / Scenario 4 Google Meet invite
FOLLOWUP_AGENT_CALLS=true
# Days after a vendor reaches Scenario 4 at which it starts again from Scenario 1
FOLLOWUP_CYCLE_DAYS=7
FOLLOWUP_MEET_INVITES=true
MEET_DURATION_MINUTES=30
# Automatic runs inside the web app
FOLLOWUP_SCHEDULER=true
FOLLOWUP_SCHEDULER_TICK_SECONDS=15
# WhatsApp number told when an automatic run fails. Empty: no alert
FOLLOWUP_ALERT_MOBILE=
FOLLOWUP_KEEP_CHECKS=120
FOLLOWUP_SOURCE_CACHE_SECONDS=20
WHATSAPP_TIMEOUT_SECONDS=20
SYSTEM_CHECK_TIMEOUT_SECONDS=10
SCM_HOD_NAME=SCM Head
SCM_HOD_MOBILE=
SCM_HEAD_EMAIL=
BUSINESS_TIMEZONE=Asia/Kolkata

# ---- Voice agent ----
# Optional accent hint, e.g. en-IN. Empty: the agent switches to Hindi or Tamil freely
GEMINI_LANGUAGE=
# Silence (ms) before the agent answers: lower = faster, too low = it cuts in on pauses
GEMINI_SILENCE_MS=300
# Hard stop for a single call, in seconds
MAX_SESSION_SECONDS=900
# PO lines the agent goes through per call. Raising it makes the call link longer; test a call before relying on it
CALL_MAX_PO_LINES=10
# Transcript turns saved per call
CALL_MAX_TRANSCRIPT_TURNS=400
TELER_TIMEOUT_SECONDS=20
CALL_WAKE_TIMEOUT_SECONDS=90

# ---- Vendor reply webhook: https://<your-domain>/webhooks/ultramsg?secret=<this> ----
ULTRAMSG_WEBHOOK_SECRET=

# ---- LangSmith tracing (optional) ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=po-voice-agent

# ---- Logging: DEBUG, INFO, WARNING or ERROR ----
LOG_LEVEL=INFO

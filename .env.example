GEMINI_API_KEY=
# Silence (ms) before the agent answers: lower = faster replies, too low = it cuts in on pauses
GEMINI_SILENCE_MS=300
TELER_API_KEY=
FREJUN_PHONE_NUMBER=
MY_PHONE_NUMBER=
PUBLIC_URL=
APP_PASSWORD=

# ---- PO sheet live sync (local only: python -m po_sync) ----
GOOGLE_SERVICE_ACCOUNT_FILE=service.json
GOOGLE_DELEGATED_USER=
PO_SHEET_ID=19iSq87epTJVePHZ3jKEYUTEIoYz9CeGkbBFms2wP22I
PO_SYNC_INTERVAL_SECONDS=60
PO_DB_HOST=localhost
PO_DB_PORT=5432
PO_DB_USER=postgres
PO_DB_PASSWORD=
PO_DB_NAME=pending_po

# ---- PO follow-up workflow (python -m po_followup) ----
# Dry run: no WhatsApp, no tracker/task changes (Alert_Log still gets DRY_RUN rows). Set false to go live.
FOLLOWUP_TEST_MODE=true
# Pilot: only these vendors are processed, and every message goes to FOLLOWUP_PILOT_MOBILE
FOLLOWUP_PILOT_MODE=true
FOLLOWUP_PILOT_VENDOR_CODES=400186
FOLLOWUP_PILOT_MOBILE=
# Test environment only: Phone_Master Scenario 1/2/3 numbers are all set to this (also after Copy from prod)
FOLLOWUP_TEST_SCENARIO_MOBILE=
# Scenario 3: the voice agent rings the Scenario 3 number (needs TELER_API_KEY, FREJUN_PHONE_NUMBER, PUBLIC_URL)
FOLLOWUP_AGENT_CALLS=true
# Day 3: Google Meet invite on GOOGLE_DELEGATED_USER's calendar (needs the calendar.events scope in domain-wide delegation)
FOLLOWUP_MEET_INVITES=true
# Pilot mode: the Meet invite only goes to this email
FOLLOWUP_PILOT_EMAIL=
FOLLOWUP_RUN_AT=08:30
FOLLOWUP_MAX_LINES_PER_MESSAGE=15
ULTRAMSG_BASE_URL=https://api.ultramsg.com/instance85918
ULTRAMSG_TOKEN=
SCM_HOD_NAME=SCM Head
SCM_HOD_MOBILE=
SCM_HEAD_EMAIL=
# Vendor reply webhook (on Render): https://<app>.onrender.com/webhooks/ultramsg?secret=<this>
ULTRAMSG_WEBHOOK_SECRET=
# On Render, paste the whole service.json content here instead of using GOOGLE_SERVICE_ACCOUNT_FILE
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- LangSmith tracing (monitoring) ----
# Off unless both are set. Same values on Render to trace live calls.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=po-voice-agent
# EU workspaces: LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# ---- Admin page (/admin on the web app; python -m po_followup admin) ----
# Admin code for /admin. Empty: falls back to APP_PASSWORD; if both are empty only this PC can open it.
ADMIN_PASSWORD=
# Automatic follow-up runs inside the web app. On by default; safe with several processes (runs are locked in PostgreSQL)
FOLLOWUP_SCHEDULER=true
# WhatsApp number told when an automatic run fails (needs ULTRAMSG_*). Empty: no alert
FOLLOWUP_ALERT_MOBILE=
# Production = the sheet mirror database; test = a separate copy you can change freely
FOLLOWUP_PROD_DB=pending_po
FOLLOWUP_TEST_DB=pending_po_test
